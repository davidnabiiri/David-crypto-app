body {
  margin: 0;
  font-family: Arial;
  background: #0f172a;
  color: white;
}

/* Center layout for auth pages */
.auth-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/* Card */
.auth-box {
  background: #1e293b;
  padding: 30px;
  border-radius: 12px;
  width: 360px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

/* Titles */
.auth-box h2 {
  margin-bottom: 5px;
}

.auth-box p {
  color: #94a3b8;
  font-size: 13px;
}

/* Inputs */
.auth-box input {
  width: 100%;
  padding: 10px;
  margin: 8px 0;
  border-radius: 6px;
  border: none;
  outline: none;
}

/* Buttons */
.auth-box button {
  width: 100%;
  padding: 10px;
  background: #3b82f6;
  border: none;
  color: white;
  border-radius: 6px;
  cursor: pointer;
  margin-top: 10px;
}

.auth-box button:hover {
  background: #2563eb;
}

/* Links */
.auth-link {
  text-align: center;
  margin-top: 10px;
}

.auth-link a {
  color: #38bdf8;
  text-decoration: none;
}